<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Layer: Web (dashboard UI).

    The Blazor dashboard: components, cookie sign-in, the per-operation scope runner and the live
    event bus. A Razor class library rather than a host of its own: the Api project composes it
    (AddDashboard / MapDashboard), so the dashboard and the machine API share one site - which is
    what the shared hosting allows - while their code stays apart.

    References Application (the services it calls) and Infrastructure (the principal holder the
    runner fills). Never Persistence or Api; DependencyRuleTests enforces both.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarWash.Hub.Application\CarWash.Hub.Application.csproj" />
    <ProjectReference Include="..\CarWash.Hub.Infrastructure\CarWash.Hub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

</Project>
