@using CarWash.Hub.Application.Features.Users
@inherits AdminDialogBase

<MudDialog>
    <DialogContent>
        @if (Message is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Message</MudAlert>
        }
        <div class="cw-form">
            <div class="cw-form-fact">
                <span class="cw-muted">@L[DashboardText.FieldUserName]</span>
                <span class="cw-mono">@User.UserName</span>
            </div>
            <MudTextField @bind-Value="_password" Label="@L[DashboardText.FieldTemporaryPassword]" HelperText="@L[DashboardText.FieldTemporaryPasswordHint]"
                          Variant="Variant.Outlined" InputType="InputType.Password" Class="cw-ltr-input" autocomplete="new-password"
                          Error="@HasError(nameof(ResetPasswordRequest.NewPassword))" ErrorText="@ErrorOf(nameof(ResetPasswordRequest.NewPassword))" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L[DashboardText.CommonCancel]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Saving" OnClick="SubmitAsync">@L[DashboardText.UsersResetPassword]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Gets or sets the user.</summary>
    [Parameter, EditorRequired]
    public UserDto User { get; set; } = default!;

    private string _password = string.Empty;

    private Task SubmitAsync() => SaveAsync<IUserService>(
        (service, token) => service.ResetPasswordAsync(new ResetPasswordRequest(User.Id, _password), token),
        L[DashboardText.UsersResetDone, User.DisplayName]);
}
