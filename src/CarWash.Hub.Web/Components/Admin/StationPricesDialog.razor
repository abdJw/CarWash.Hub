@* A station's price list and run times: set a price for a service from a day on, and see each
   service's current, upcoming and past prices; set the run times the machines offer per selector
   position. Both are sent to the station's machines as their settings. Stays open across saves -
   prices are usually set several at a time. *@
@using CarWash.Hub.Application.Features.DeviceSettings
@using CarWash.Hub.Application.Features.Pricing
@inherits AdminDialogBase
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (Message is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Message</MudAlert>
        }

        @if (_prices is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <section class="cw-form cw-price-form">
                <h3 class="cw-card-title">@L[DashboardText.PricesSetTitle]</h3>
                <div class="cw-price-fields">
                    <MudSelect T="string" @bind-Value="_service" Label="@L[DashboardText.FieldService]" Variant="Variant.Outlined" Dense="true"
                               Error="@HasError(nameof(SetStationPriceRequest.Service))" ErrorText="@ErrorOf(nameof(SetStationPriceRequest.Service))">
                        @foreach (var service in _prices.Services)
                        {
                            <MudSelectItem Value="service.Service">
                                <span class="cw-icon-option"><MudIcon Icon="@Services.Icon(service.Service)" Size="Size.Small" /> @Services.Name(service.Service)</span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal?" @bind-Value="_price" Label="@L[DashboardText.FieldPrice]" Variant="Variant.Outlined"
                                     Min="0m" Max="Domain.Entities.StationServicePrice.MaxUnitPrice" Step="0.05m" Format="0.000" Culture="CultureInfo.InvariantCulture"
                                     Adornment="Adornment.End" AdornmentText="@L[DashboardText.FinanceCurrency]" Class="cw-ltr-input"
                                     Error="@HasError(nameof(SetStationPriceRequest.UnitPrice))" ErrorText="@ErrorOf(nameof(SetStationPriceRequest.UnitPrice))" />
                    <MudDatePicker @bind-Date="_from" Label="@L[DashboardText.FieldEffectiveFrom]" Variant="Variant.Outlined"
                                   Error="@HasError(nameof(SetStationPriceRequest.EffectiveFrom))" ErrorText="@ErrorOf(nameof(SetStationPriceRequest.EffectiveFrom))" />
                </div>
                <MudTextField @bind-Value="_note" Label="@L[DashboardText.FieldPriceNote]" Variant="Variant.Outlined" MaxLength="Domain.Entities.StationServicePrice.NoteMaxLength"
                              Error="@HasError(nameof(SetStationPriceRequest.Note))" ErrorText="@ErrorOf(nameof(SetStationPriceRequest.Note))" />
                <p class="cw-muted cw-small">@L[DashboardText.PricesHint]</p>
                <p class="cw-muted cw-small">@L[DashboardText.PricesDeviceRule]</p>
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Sell"
                               Disabled="@(Saving || _service is null || _price is null || _from is null)" OnClick="SetAsync">
                        @L[DashboardText.PricesSet]
                    </MudButton>
                </div>
            </section>

            @if (_durations is not null)
            {
                <section class="cw-form cw-duration-form">
                    <h3 class="cw-card-title">@L[DashboardText.DurationsTitle]</h3>
                    <p class="cw-muted cw-small">@L[DashboardText.DurationsHint]</p>
                    @foreach (var service in _durations.Services)
                    {
                        var edit = _edits[service.Service];
                        <div class="cw-duration-row" @key="service.Service">
                            <span class="cw-icon-option cw-duration-name">
                                <MudIcon Icon="@Services.Icon(service.Service)" Size="Size.Small" />
                                <strong>@Services.Name(service.Service)</strong>
                                @if (service.IsSuggested)
                                {
                                    <span class="cw-status cw-status--warning cw-small">@L[DashboardText.DurationsSuggested]</span>
                                }
                            </span>
                            <div class="cw-duration-fields">
                                @for (var position = 0; position < service.Positions; position++)
                                {
                                    var index = position;
                                    <MudNumericField T="int?" Value="edit[index]" ValueChanged="value => edit[index] = value"
                                                     Label="@(service.Positions == 1 ? L[DashboardText.DurationsSingle] : L[DashboardText.DurationsPosition, index + 1])"
                                                     Min="Domain.Entities.StationServiceDuration.MinSeconds" Max="Domain.Entities.StationServiceDuration.MaxSeconds"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Culture="CultureInfo.InvariantCulture"
                                                     Adornment="Adornment.End" AdornmentText="@L[DashboardText.DurationsSecondsUnit]" Class="cw-ltr-input" />
                                }
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Timer"
                                       Disabled="@(Saving || edit.Any(value => value is null))" OnClick="() => SetDurationsAsync(service.Service)">
                                @L[DashboardText.DurationsSave]
                            </MudButton>
                        </div>
                    }
                </section>
            }

            <ul class="cw-price-list">
                @foreach (var service in _prices.Services)
                {
                    <li class="cw-price-item" @key="service.Service">
                        <div class="cw-price-head">
                            <span class="cw-icon-option">
                                <MudIcon Icon="@Services.Icon(service.Service)" Size="Size.Small" />
                                <strong>@Services.Name(service.Service)</strong>
                            </span>
                            @if (service.Current is { } current)
                            {
                                <span class="cw-price-now">
                                    <strong>@Format.Money(current.UnitPrice)</strong>
                                    <span class="cw-muted">@L[DashboardText.FinanceSince, DashboardFormat.Date(current.EffectiveFrom)]</span>
                                </span>
                            }
                            else
                            {
                                <span class="cw-status cw-status--warning">
                                    <MudIcon Icon="@Icons.Material.Rounded.Warning" Size="Size.Small" />
                                    @L[DashboardText.PricesNone]
                                </span>
                            }
                        </div>

                        @if (service.Next is { } next)
                        {
                            <p class="cw-muted cw-small cw-price-next">
                                <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" />
                                @L[DashboardText.PricesUpcoming, Format.Money(next.UnitPrice), DashboardFormat.Date(next.EffectiveFrom)]
                            </p>
                        }

                        @if (service.History.Count > 0)
                        {
                            <details class="cw-price-history">
                                <summary>@L[DashboardText.PricesHistory, service.History.Count]</summary>
                                <div class="viz-table-wrap">
                                    <table class="viz-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">@L[DashboardText.FieldEffectiveFrom]</th>
                                                <th scope="col">@L[DashboardText.FieldPrice]</th>
                                                <th scope="col">@L[DashboardText.PricesSetBy]</th>
                                                <th scope="col"><span class="cw-visually-hidden">@L[DashboardText.PricesRemove]</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in service.History)
                                            {
                                                <tr @key="entry.Id" class="@(entry.Id == service.Current?.Id ? "is-current" : null)">
                                                    <th scope="row">
                                                        @DashboardFormat.Date(entry.EffectiveFrom)
                                                        @if (entry.Note is { } note)
                                                        {
                                                            <span class="cw-muted cw-price-note"><bdi>@note</bdi></span>
                                                        }
                                                    </th>
                                                    <td>@DashboardFormat.Amount(entry.UnitPrice)</td>
                                                    <td>
                                                        <bdi>@(entry.SetBy ?? "—")</bdi>
                                                        <span class="cw-muted cw-price-note">@Format.DateTime(entry.SetAt)</span>
                                                    </td>
                                                    <td>
                                                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Disabled="Saving"
                                                                       aria-label="@L[DashboardText.PricesRemove]" title="@L[DashboardText.PricesRemove]"
                                                                       OnClick="() => RemoveAsync(service.Service, entry)" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Done">@L[DashboardText.CommonDone]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private StationPricesDto? _prices;
    private StationDurationsDto? _durations;
    private readonly Dictionary<string, int?[]> _edits = new(StringComparer.OrdinalIgnoreCase);
    private string? _service;
    private decimal? _price;
    private DateTime? _from;
    private string? _note;
    private bool _changed;

    /// <summary>Gets or sets the station whose prices are shown.</summary>
    [Parameter, EditorRequired]
    public Guid StationId { get; set; }

    /// <summary>Gets or sets the service names and icons.</summary>
    [Parameter, EditorRequired]
    public ServiceLookup Services { get; set; } = ServiceLookup.Empty;

    [Inject]
    private DashboardFormat Format { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _service = _prices?.Services.FirstOrDefault(service => service.Current is null)?.Service ?? _prices?.Services.FirstOrDefault()?.Service;
        _from = _prices?.Today.ToDateTime(TimeOnly.MinValue);
    }

    private async Task LoadAsync()
    {
        _prices = await Runner.QueryAsync<IStationPriceService, StationPricesDto>((service, token) => service.GetAsync(StationId, token));
        await LoadDurationsAsync();
    }

    // The fields start from what is saved, or from the suggestions; an unsaved edit of another
    // service survives a save of this one.
    private async Task LoadDurationsAsync(string? reset = null)
    {
        _durations = await Runner.QueryAsync<IStationDurationService, StationDurationsDto>((service, token) => service.GetAsync(StationId, token));
        foreach (var service in _durations.Services)
        {
            if (reset is null || !_edits.ContainsKey(service.Service) || string.Equals(reset, service.Service, StringComparison.OrdinalIgnoreCase))
            {
                _edits[service.Service] = [.. service.Seconds.Select(seconds => (int?)seconds)];
            }
        }
    }

    private async Task SetDurationsAsync(string code)
    {
        var edit = _edits[code];
        if (edit.Any(value => value is null))
        {
            return;
        }

        var saved = await SaveAsync<IStationDurationService>(
            (service, token) => service.SetAsync(
                new SetStationDurationsRequest { StationId = StationId, Service = code, Seconds = [.. edit.Select(value => value!.Value)] },
                token),
            L[DashboardText.DurationsSaved],
            close: false);

        if (saved)
        {
            _changed = true;
            await LoadDurationsAsync(reset: code);
        }
    }

    private async Task SetAsync()
    {
        if (_service is null || _price is not { } price || _from is not { } from)
        {
            return;
        }

        var saved = await SaveAsync<IStationPriceService>(
            (service, token) => service.SetAsync(
                new SetStationPriceRequest
                {
                    StationId = StationId,
                    Service = _service,
                    UnitPrice = price,
                    EffectiveFrom = DateOnly.FromDateTime(from),
                    Note = _note,
                },
                token),
            L[DashboardText.PricesSaved],
            close: false);

        if (saved)
        {
            _changed = true;
            _price = null;
            _note = null;
            await LoadAsync();
        }
    }

    private async Task RemoveAsync(string service, PriceEntryDto entry)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L[DashboardText.PricesRemoveTitle],
            L[DashboardText.PricesRemoveText, Services.Name(service), Format.Money(entry.UnitPrice), DashboardFormat.Date(entry.EffectiveFrom)],
            yesText: L[DashboardText.PricesRemove],
            cancelText: L[DashboardText.CommonCancel]);

        if (confirmed != true)
        {
            return;
        }

        if (await SaveAsync<IStationPriceService>((prices, token) => prices.DeleteAsync(entry.Id, token), L[DashboardText.PricesRemoved], close: false))
        {
            _changed = true;
            await LoadAsync();
        }
    }

    private void Done() => Dialog.Close(DialogResult.Ok(_changed));
}
