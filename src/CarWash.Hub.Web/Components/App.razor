@* The document every dashboard page renders into. Rendered on the server for each full page load,
   so the language and direction come from the request's culture (cookie, else the dashboard
   default). Interactive pages are not prerendered: the circuit renders them once, after it
   connects, and the splash covers the wait. The account pages are static and get no circuit. *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#2563eb" />
    <base href="/" />
    <title>CarWash Hub</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/CarWash.Hub.Web/css/dashboard.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @if (PageRenderMode is not null)
    {
        <div id="cw-splash" class="cw-splash" aria-live="polite">
            <svg class="cw-splash-mark" viewBox="0 0 48 48" aria-hidden="true"><use href="#cw-logo" /></svg>
            <p>@L[DashboardText.AppLoading]</p>
        </div>
    }

    <svg width="0" height="0" class="cw-symbols" aria-hidden="true">
        <symbol id="cw-logo" viewBox="0 0 48 48">
            <rect x="4" y="4" width="40" height="40" rx="12" fill="currentColor" opacity=".14" />
            <path d="M14 28.5 17.2 20a3 3 0 0 1 2.8-2h8a3 3 0 0 1 2.8 2l3.2 8.5V34a1.5 1.5 0 0 1-1.5 1.5h-1A1.5 1.5 0 0 1 30 34v-1.5H18V34a1.5 1.5 0 0 1-1.5 1.5h-1A1.5 1.5 0 0 1 14 34v-5.5Zm4.2-1.5h11.6l-1.9-5.2a1 1 0 0 0-.9-.6h-6a1 1 0 0 0-.9.6L18.2 27Z" fill="currentColor" />
            <path d="M18 14c0-1.4 1-2.6 2-4 1 1.4 2 2.6 2 4a2 2 0 1 1-4 0Zm8 0c0-1.4 1-2.6 2-4 1 1.4 2 2.6 2 4a2 2 0 1 1-4 0Z" fill="currentColor" />
        </symbol>
    </svg>

    <Routes @rendermode="PageRenderMode" />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/CarWash.Hub.Web/js/dashboard.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private IStringLocalizer<DashboardResource> L { get; set; } = default!;

    // Interactive Server for every page that allows it; static for the account pages, which mark
    // themselves [ExcludeFromInteractiveRouting] because signing in needs the HTTP response.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
