@* A user changes their own password. Static, like sign-in: the new security stamp ends every other
   session, and this one is re-issued with it, which needs the HTTP response. *@
@page "/account/password"
@using CarWash.Hub.Application.Exceptions
@using CarWash.Hub.Application.Features.Users
@using CarWash.Hub.Domain.Constants
@using Microsoft.AspNetCore.Authentication
@attribute [Authorize(Policy = DashboardPolicies.Authenticated)]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject IUserService Users
@inject IStringLocalizer<DashboardResource> L
@inject NavigationManager Navigation

<PageTitle>@L[DashboardText.PasswordTitle] · @L[DashboardText.AppName]</PageTitle>

<h1 class="cw-auth-title">@L[DashboardText.PasswordTitle]</h1>

@if (_changed)
{
    <p class="cw-auth-subtitle">@L[DashboardText.PasswordChanged]</p>
    <a class="cw-auth-submit" href="@DashboardAuthentication.SafeReturnUrl(ReturnUrl)">@L[DashboardText.PasswordContinue]</a>
}
else
{
    <p class="cw-auth-subtitle">@(MustChange ? L[DashboardText.PasswordMustChange] : L[DashboardText.PasswordIntro])</p>

    @if (_errors.Count > 0)
    {
        <div class="cw-auth-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <EditForm Model="Input!" method="post" FormName="password" OnSubmit="SubmitAsync" class="cw-auth-form">
        <label for="password-current">@L[DashboardText.PasswordCurrent]</label>
        <InputText id="password-current" type="password" @bind-Value="Input!.Current" autocomplete="current-password" required />

        <label for="password-new">@L[DashboardText.PasswordNew]</label>
        <InputText id="password-new" type="password" @bind-Value="Input!.New" autocomplete="new-password" minlength="8" required />

        <label for="password-confirm">@L[DashboardText.PasswordConfirm]</label>
        <InputText id="password-confirm" type="password" @bind-Value="Input!.Confirm" autocomplete="new-password" minlength="8" required />

        <button type="submit" class="cw-auth-submit">@L[DashboardText.CommonSave]</button>
        @if (!MustChange)
        {
            <a class="cw-auth-secondary" href="@DashboardAuthentication.SafeReturnUrl(ReturnUrl)">@L[DashboardText.CommonCancel]</a>
        }
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordForm? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private readonly List<string> _errors = [];
    private bool _changed;

    private bool MustChange => HttpContext.User.HasClaim(claim => claim.Type == CustomClaimTypes.MustChangePassword);

    protected override void OnInitialized() => Input ??= new PasswordForm();

    private async Task SubmitAsync()
    {
        var form = Input ?? new PasswordForm();
        if (!string.Equals(form.New, form.Confirm, StringComparison.Ordinal))
        {
            _errors.Add(L[DashboardText.PasswordMismatch]);
            return;
        }

        try
        {
            var user = await Users.ChangeOwnPasswordAsync(new ChangePasswordRequest(form.Current ?? string.Empty, form.New ?? string.Empty), HttpContext.RequestAborted);

            // Keep the session's "keep me signed in" choice; only the stamp and the claims change.
            var current = await HttpContext.AuthenticateAsync(DashboardAuthentication.Scheme);
            await HttpContext.SignInAsync(DashboardAuthentication.Scheme, DashboardAuthentication.CreatePrincipal(user), current.Properties);
            _changed = true;
        }
        catch (ValidationException exception)
        {
            _errors.AddRange(exception.Errors.Values.SelectMany(messages => messages));
        }
        finally
        {
            form.Current = form.New = form.Confirm = null;
        }
    }

    private sealed class PasswordForm
    {
        public string? Current { get; set; }

        public string? New { get; set; }

        public string? Confirm { get; set; }
    }
}
