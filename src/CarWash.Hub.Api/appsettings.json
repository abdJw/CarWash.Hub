{
  "Seed": {
    "ApplyMigrations": false,
    "SeedData": true
  },

  "BackgroundWorkers": {
    "Enabled": true
  },

  "Dashboard": {
    "TimeZone": "Asia/Amman",
    "DefaultCulture": "ar-SA",
    "PublicBaseUrl": null
  },

  "DashboardAuth": {
    "ExpireHours": 12,
    "RememberMeDays": 14,
    "RevalidationMinutes": 5,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Alerts": {
    "NoActivityAfterHours": 6,
    "BusyWithinMinutes": 15,
    "CheckIntervalSeconds": 60,
    "StartupGraceMinutes": 15,
    "OfflineAfterMinutes": 3,
    "WaterUnavailableAfterMinutes": 1
  },

  "DeviceSettings": {
    "ReconcileIntervalSeconds": 60
  },

  "Processing": {
    "BatchSize": 200,
    "SweepIntervalSeconds": 30,
    "MaxPastSkew": "7.00:00:00",
    "MaxFutureSkew": "00:10:00",
    "RetryMinDelay": "00:00:02"
  },

  "ClientKeys": {
    "IngestKeys": [],
    "ReadKeys": []
  },

  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },

  "ApiDocumentation": {
    "Enabled": null,
    "AllowedNetworks": []
  },

  "RateLimiting": {
    "Enabled": true,
    "IngestPermitLimit": 600,
    "IngestWindowSeconds": 60,
    "SettingsPermitLimit": 1200,
    "SettingsWindowSeconds": 60
  },

  "RequestLogging": {
    "Enabled": true,
    "SlowRequestThresholdMs": 2000,
    "ExcludedPathPrefixes": [ "/health", "/swagger", "/scalar", "/favicon.ico", "/favicon.svg", "/_blazor", "/_framework", "/_content" ]
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/carwash-hub-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 31,
                "fileSizeLimitBytes": 52428800,
                "rollOnFileSizeLimit": true,
                "shared": false,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{ClientKeyId}] [{MachineName}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
