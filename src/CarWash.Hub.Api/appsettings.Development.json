{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=carwash_hub_dev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },

  "Seed": {
    "ApplyMigrations": true
  },

  "ClientKeys": {
    "IngestKeys": [
      { "Id": "dev-ingest", "Key": "dev-only-ingest-key-0123456789abcdef" }
    ],
    "ReadKeys": [
      { "Id": "dev-read", "Key": "dev-only-read-key-0123456789abcdefgh" }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  }
}
