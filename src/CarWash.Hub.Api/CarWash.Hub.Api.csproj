<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Layer: Api (outermost) - composition root.

    Controllers, middleware, filters, Swagger setup and DI composition. It references Persistence
    only so that Program.cs can call AddPersistence(); no Persistence type may appear anywhere else
    in this project (see README, "Dependency rule").
  -->

  <PropertyGroup>
    <!-- The client keys and the connection string are read from user-secrets in Development and
         from environment variables elsewhere. They are never committed. -->
    <UserSecretsId>carwash-hub-api</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarWash.Hub.Application\CarWash.Hub.Application.csproj" />
    <ProjectReference Include="..\CarWash.Hub.Infrastructure\CarWash.Hub.Infrastructure.csproj" />
    <!-- DI registration only. -->
    <ProjectReference Include="..\CarWash.Hub.Persistence\CarWash.Hub.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup Label="OpenAPI and versioning">
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
  </ItemGroup>

  <ItemGroup Label="Validation wiring">
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup Label="Design-time EF tooling">
    <!-- Api is the startup project for `dotnet ef`: the tools build this host to obtain the
         DbContext, so the connection string comes from the same configuration stack the running
         application uses. There is no IDesignTimeDbContextFactory. Neither package is shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
