# Copy to .env (never committed) and fill in the blanks. docker-compose.yml refuses to start
# while a required value is empty.

# SQL Server (docker-compose only). The SA password must meet SQL Server's complexity rules:
# at least 8 characters from three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Staging

# The shared key every machine sends in the client-secret-key header, and the separate key for the
# read endpoints (client-read-key). 32 to 256 characters, no spaces, and different from each other.
# Generate each with:   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
CLIENT_SECRET_KEY_ID=k1
CLIENT_SECRET_KEY=
CLIENT_READ_KEY_ID=r1
CLIENT_READ_KEY=
