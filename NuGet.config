<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Repo-local package sources.

    <clear/> discards machine- and user-level feeds so a restore produces the same result on a
    developer laptop, in CI and inside the Docker build. It also satisfies NU1507, which Central
    Package Management raises when more than one unmapped source is configured.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
